# /etc/vlana.env (chmod 600)
PUBLIC_URL=https://go.vlana.app
PORT=8792
DATA_DIR=/var/lib/vlana
TRUST_PROXY=1
# no token yet: everyone gets the dev plan. remove once MINT is set
DEV_FREE=1
MINT=
RPC_URL=https://api.mainnet-beta.solana.com
# payouts stay manual until PAYER_KEY (treasury secret, base58) is set
PAYER_KEY=
BUYBACK_WALLET=
# openssl rand -hex 24
ADMIN_KEY=
PROBE_KEY=
REPO_URL=
