# /etc/nginx/sites-available/vlana.app
#   vlana.app     landing page (static export in /var/www/vlana-landing)
#   go.vlana.app  the app: Node on 127.0.0.1:8792
# certificate: certbot certonly --webroot -w /var/www/vlana-acme -d vlana.app -d go.vlana.app

upstream vlana_app { server 127.0.0.1:8792; }

server {
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name go.vlana.app;

    ssl_certificate /etc/letsencrypt/live/vlana.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vlana.app/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/snippets/cloudflare-realip.conf;
    access_log off;
    error_log /var/log/nginx/vlana.app.error.log;
    client_max_body_size 1m;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location ^~ /.well-known/acme-challenge/ { root /var/www/vlana-acme; }

    location / {
        proxy_pass http://vlana_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-Connecting-IP "";
        proxy_read_timeout 30s;
    }
}

server {
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name vlana.app;

    ssl_certificate /etc/letsencrypt/live/vlana.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vlana.app/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/snippets/cloudflare-realip.conf;
    access_log off;
    error_log /var/log/nginx/vlana.app.error.log;
    client_max_body_size 1m;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location ^~ /.well-known/acme-challenge/ { root /var/www/vlana-acme; }

    # links handed out before the app moved to go.vlana.app: subscriptions, nodes, installer
    location ~ ^/(api/|sub/|install\.sh$|agent\.py$) {
        proxy_pass http://vlana_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-Connecting-IP "";
        proxy_read_timeout 30s;
    }

    root /var/www/vlana-landing;
    index index.html;
    location / { try_files $uri $uri/ =404; }
    location ~ ^/legal/([a-z-]+)/?$ { try_files /subpages/legal_$1.html =404; }
    location ~* \.(mjs|js|css|woff2?|ttf|otf|png|jpe?g|webp|avif|svg|gif|mp4|webm|json)$ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }
}
